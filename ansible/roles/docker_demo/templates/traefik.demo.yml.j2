# Traefik of the demo instance: certificates by HTTP challenge, so the server needs
# only an A record of {{ demo_domain }} (not proxied by Cloudflare)
global:
  checkNewVersion: false
  sendAnonymousUsage: false

entryPoints:
  web:
    address: :80
    http:
      redirections:
        entryPoint:
          to: websecure
          scheme: https
  websecure:
    address: :443
    http:
      tls:
        certResolver: le

log:
  level: WARN

providers:
  docker:
    endpoint: unix:///var/run/docker.sock
    exposedByDefault: false

certificatesResolvers:
  le:
    acme:
      email: '{{ acme_email }}'
      keyType: EC256
      storage: /letsencrypt/acme.json
      httpChallenge:
        entryPoint: web
